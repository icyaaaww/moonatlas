///|
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
}

///|
async fn main {
  @shell.Cmd("moon", ["build", "--target", "js", "--release"]).run()
  @fs.write_file("web/core.mjs", @fs.read_file("_build/js/release/build/bridge/bridge.js"))
  @shell.Cmd("node", ["node_modules/esbuild/bin/esbuild", "web/app.mjs", "--bundle", "--format=iife", "--target=es2022", "--charset=utf8", "--outfile=dist/app.js"]).run()
  let html = @fs.read_file("web/index.html").text()
  let css = @fs.read_file("web/style.css").text()
  let js = @fs.read_file("dist/app.js").text().replace_all(old="</script",new="<\\/script")
  let bundled = html.replace_all(old="<link rel=\"stylesheet\" href=\"style.css\">",new="<style>"+css+"</style>").replace_all(old="<script type=\"module\" src=\"app.mjs\"></script>",new="<script>"+js+"</script>")
  @fs.write_file("dist/MoonAtlas.html",bundled)
  println("MoonAtlas: generated MoonBit bridge and standalone dist/MoonAtlas.html")
}
